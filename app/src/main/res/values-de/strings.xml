    <!-- Accessibility Service (for AndroidManifest.xml) -->
    <string name="accessibility_service_description">QuickBall-Dienst, der eine schwebende Kugel auf Ihrem Bildschirm für schnellen Zugriff auf Funktionen bereitstellt.</string>

