    <string name="onboarding_title">Conheça o Quick Ball</string>
    <string name="onboarding_subtitle">Um botão flutuante que coloca a navegação com uma mão e ações rápidas em qualquer lugar da tela. Ele nunca lê o conteúdo da tela e nada sai do seu dispositivo.</string>
