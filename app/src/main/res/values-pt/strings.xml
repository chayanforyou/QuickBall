    <!-- Onboarding & Permissions -->
    <string name="onboarding_title">Conheça o Quick Ball</string>
    <string name="onboarding_subtitle">Um botão flutuante que coloca a navegação com uma mão e ações rápidas em qualquer lugar da tela. Ele nunca lê o conteúdo da tela e nada sai do seu dispositivo.</string>
    <string name="onboarding_bullet_1">Início, Voltar, Recentes e muito mais em um menu personalizado por você</string>
    <string name="onboarding_bullet_2">Gestos de deslizar, controles de mídia e atalhos com um toque</string>
    <string name="onboarding_get_started">Começar</string>
    <string name="onboarding_permissions_title">Permissões</string>
    <string name="onboarding_permissions_subtitle">O Quick Ball precisa apenas dessas duas permissões para funcionar. Qualquer outra é solicitada apenas quando você ativa um recurso que precisa dela.</string>
    <string name="onboarding_accessibility_title">Acessibilidade</string>
    <string name="onboarding_accessibility_description">Alimenta o botão flutuante e permite que o Quick Ball execute ações de navegação como Início, Voltar e Recentes. Nunca lê o conteúdo da tela.</string>
    <string name="onboarding_system_settings_description">Permite que o Quick Ball ajuste configurações do sistema como brilho da tela e volume diretamente do menu flutuante.</string>
    <string name="onboarding_permissions_warning">O Quick Ball precisa das permissões de Acessibilidade e Configurações do Sistema para funcionar corretamente.</string>
