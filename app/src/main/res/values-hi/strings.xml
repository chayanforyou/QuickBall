    <string name="onboarding_permissions_title">अनुमतियाँ</string>
    <string name="onboarding_permissions_subtitle">Quick Ball को चलाने के लिए बस इन दो अनुमतियों की आवश्यकता है। बाकी सब केवल तब मांगा जाता है जब आप कोई सुविधा चालू करते हैं।</string>
    <string name="onboarding_accessibility_title">एक्सेसिबिलिटी</string>
    <string name="onboarding_accessibility_description">फ्लोटिंग बटन को संचालित करता है और Quick Ball को होम, बैक और हाल के ऐप्स जैसी नेविगेशन क्रियाएं करने देता है।</string>
    <string name="onboarding_system_settings_description">Quick Ball को सीधे फ्लोटिंग मेनू से स्क्रीन ब्राइटनेस और वॉल्यूम जैसी सिस्टम सेटिंग्स को समायोजित करने देता है।</string>
    <string name="onboarding_permissions_warning">Quick Ball को ठीक से काम करने के लिए एक्सेसिबिलिटी और सिस्टम सेटिंग्स अनुमति की आवश्यकता है।</string>
